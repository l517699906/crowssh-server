{
  "version": 1,
  "rules": [
    {
      "id": "user-task-change",
      "role": "user",
      "type": "TASK_CHANGE",
      "pattern": "不对|不是这样|改一下|换个思路|换种方式|错了"
    },
    {
      "id": "user-task-complete",
      "role": "user",
      "type": "TASK_COMPLETE",
      "pattern": "完成了|搞定|结束|好了"
    },
    {
      "id": "user-correction",
      "role": "user",
      "type": "USER_CORRECTION",
      "pattern": "不要|停|别"
    },
    {
      "id": "tool-error",
      "role": "tool",
      "type": "ERROR",
      "caseInsensitive": true,
      "pattern": "error|failed|exception|permission denied|not found|refused"
    }
  ]
}
