map $http_origin $crowssh_desktop_cors_origin {
    default "";
    "tauri://localhost" $http_origin;
    "http://tauri.localhost" $http_origin;
    "https://tauri.localhost" $http_origin;
    "http://localhost:1420" $http_origin;
    "http://localhost:5173" $http_origin;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${CROWSSH_SERVER_NAME};

    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${CROWSSH_SERVER_NAME};

    ssl_certificate /etc/letsencrypt/live/${CROWSSH_SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CROWSSH_SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:CROWSSH_TLS:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    client_max_body_size 1025m;
    error_page 413 = @crowssh_payload_too_large;

    location /api/ {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location @crowssh_payload_too_large {
        default_type application/json;
        charset utf-8;
        add_header Access-Control-Allow-Origin $crowssh_desktop_cors_origin always;
        add_header Vary "Origin" always;
        return 413 '{"code":"PAYLOAD_TOO_LARGE","info":"上传失败：文件大小超过 1 GB 限制","data":null}';
    }

    # 生产模板只暴露 CrowSSH API；docs 下的静态演示页不得作为认证入口部署。
    location / {
        return 404;
    }
}
